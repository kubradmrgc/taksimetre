# En az birini doldurmanız önerilir (küçük şehirlerde OSM yetersiz kalabilir).
# Geliştirmede istekler Vite proxy üzerinden gider (CORS yok).

# 1) Önerilen — Google Places (Maps Platform)
# https://console.cloud.google.com/ → Places API etkinleştir
VITE_GOOGLE_PLACES_API_KEY=

# 2) Foursquare Places (küresel POI)
# https://developer.foursquare.com/
VITE_FOURSQUARE_API_KEY=

# 3) Geoapify Places (ücretsiz kota)
# https://www.geoapify.com/
VITE_GEOAPIFY_API_KEY=
